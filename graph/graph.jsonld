    {
      "@id": "kt:overprotection",
      "@type": "kto:StrategicConcept",
      "skos:prefLabel": "Overprotection",
      "skos:definition": "Aron Nimzowitsch's principle of giving a strategically important point, usually a central pawn or square, more protection than it currently needs, so that the defending pieces gain in effectiveness and the opponent is discouraged from attacking that point at all.",
      "kto:domain": "middlegame-strategy",
      "dcterms:created": "2026-11-17",
      "kto:verified": "2026-11-17",
