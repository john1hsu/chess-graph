    {
      "@id": "kt:chunking-theory",
      "@type": "kto:CognitiveConcept",
      "skos:prefLabel": "Chunking theory",
      "skos:definition": "The theory, proposed by William Chase and Herbert Simon in 1973, that chess skill rests on a large store of familiar piece configurations (\"chunks\") held in long-term memory, which strong players recognise as single units and which cue relevant moves.",
      "kto:domain": "training-and-improvement",
      "dcterms:created": "2026-11-08",
      "kto:verified": "2026-11-08",
