    {
      "@id": "kt:deep-blue-versus-kasparov",
      "@type": "kto:Event",
      "skos:prefLabel": "Deep Blue versus Kasparov",
      "skos:definition": "The two six-game matches between world champion Garry Kasparov and IBM's chess computer Deep Blue: Kasparov won in Philadelphia in February 1996 by 4–2, and Deep Blue won the New York rematch in May 1997 by 3½–2½, the first match defeat of a reigning world champion by a computer under tournament conditions.",
      "kto:domain": "history",
      "dcterms:created": "2026-11-07",
      "kto:verified": "2026-11-07",
      "kto:status": "historical",
      "kto:volatile": false,
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Deep Blue (Artificial Intelligence 134, 2002)",
          "dcterms:publisher": "M. Campbell, A. J. Hoane Jr., F. Hsu (copy hosted by Northern Arizona University)",
          "schema:url": "https://www.cefns.nau.edu/~edo/Classes/CS470-570_WWW/Readings/Campbell2002.pdf",
          "kto:sourceType": "peer-reviewed"
