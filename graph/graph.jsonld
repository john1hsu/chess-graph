    {
      "@id": "kt:nimzo-indian-defence",
      "@type": "kto:Opening",
      "skos:prefLabel": "Nimzo-Indian Defence",
      "skos:definition": "A hypermodern defence to 1.d4 arising after 1.d4 Nf6 2.c4 e6 3.Nc3 Bb4, in which Black pins the c3-knight to fight for e4 with pieces and is often ready to give up the bishop pair in return for damaging White's pawn structure.",
      "kto:domain": "openings",
      "dcterms:created": "2026-11-10",
      "kto:verified": "2026-11-10",
      "kto:status": "current",
      "kto:volatile": false,
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Indian Openings in Chess",
          "dcterms:publisher": "Edward Winter, Chess Notes (chesshistory.com)",
          "schema:url": "https://chesshistory.com/winter/extra/indianopenings.html",
          "kto:sourceType": "reference"
        },
        {
          "dcterms:title": "Aron Nimzowitsch",
          "dcterms:publisher": "Encyclopaedia Britannica",
          "schema:url": "https://www.britannica.com/print/article/415505",
          "kto:sourceType": "reference"
        },
        {
          "dcterms:title": "Grandmaster Repertoire: The Nimzo-Indian Defence (sample pages: preface and contents)",
          "dcterms:publisher": "Michael Roiz, Quality Chess (2016), New In Chess product sample PDF",
          "schema:url": "https://www.newinchess.com/media/wysiwyg/product_pdf/7669.pdf",
          "kto:sourceType": "book"
        },
        {
          "dcterms:title": "The Nimzo-Indian: Move by Move (sample pages: introduction and contents)",
          "dcterms:publisher": "John Emms, Everyman Chess (2011), New In Chess product sample PDF",
          "schema:url": "https://www.newinchess.com/media/wysiwyg/product_pdf/7030.pdf",
          "kto:sourceType": "book"
