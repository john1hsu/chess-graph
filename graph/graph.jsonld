      "@id": "kt:saavedra-position",
      "@type": "kto:Game",
      "skos:prefLabel": "Saavedra position",
      "skos:definition": "The most famous endgame study, published in Glasgow in 1895: White (Kb6, Pc6) beats a lone rook (Black Ka1, Rd5) only by escaping the checks and then promoting to a rook instead of a queen, which avoids a stalemate trap. The win is credited to Fernando Saavedra, though its origin is disputed.",
      "kto:domain": "variants-and-compositions",
      "dcterms:created": "2026-11-14",
      "kto:verified": "2026-11-14",
      "kto:status": "current",
