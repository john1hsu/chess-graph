      "@id": "kt:zugzwang",
      "@type": "kto:StrategicConcept",
      "skos:prefLabel": "Zugzwang",
      "skos:definition": "A position in which the obligation to make a move is a disadvantage: the side to move would get a better result if it could pass. When this holds for both sides at once it is a mutual zugzwang, and the result depends only on whose turn it is.",
      "kto:domain": "endgames",
      "dcterms:created": "2026-11-09",
      "kto:verified": "2026-11-09",
