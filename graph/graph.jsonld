    {
      "@id": "kt:the-turk",
      "@type": "kto:Artifact",
      "skos:prefLabel": "The Turk",
      "skos:definition": "A celebrated chess-playing \"automaton\" unveiled by Wolfgang von Kempelen at the Viennese court around 1769–1770: a turbaned figure seated at a cabinet that appeared to play chess by machinery but was secretly worked by a strong human player hidden inside. It toured Europe and America for decades until it was destroyed by fire in Philadelphia in 1854.",
      "kto:domain": "history",
      "dcterms:created": "2026-11-15",
      "kto:verified": "2026-11-15",
      "kto:status": "historical",
