      "@id": "kt:quiescence-search",
      "@type": "kto:Algorithm",
      "skos:prefLabel": "Quiescence search",
      "skos:definition": "A selective extension at the leaves of a chess engine's main search that keeps exploring captures (and sometimes checks) until the position is quiet, so that the evaluation function is only applied to positions where no immediate tactic is about to change the score.",
      "kto:domain": "computer-chess",
      "dcterms:created": "2026-11-08",
