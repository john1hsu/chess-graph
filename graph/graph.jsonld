    {
      "@id": "kt:carlsbad-structure",
      "@type": "kto:PawnStructure",
      "skos:prefLabel": "Carlsbad structure",
      "skos:definition": "A pawn structure in which White has pawns on d4 and e3 (with a2 and b2) against Black's d5 and c6 (with a7 and b7), so that White has a half-open c-file and Black a half-open e-file; it is typical of the Queen's Gambit Declined Exchange Variation and arises reversed in the Caro-Kann Exchange and the London System.",
      "kto:domain": "middlegame-strategy",
      "dcterms:created": "2026-11-12",
