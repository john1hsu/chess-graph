    {
      "@id": "kt:material-advantage",
      "@type": "kto:StrategicConcept",
      "skos:prefLabel": "Material advantage",
      "skos:definition": "Having more or more valuable pieces and pawns than the opponent, measured with conventional piece values (pawn 1, knight and bishop about 3, rook about 5, queen about 9) that guide decisions about exchanges, sacrifices and simplification.",
      "kto:domain": "middlegame-strategy",
      "dcterms:created": "2026-11-09",
