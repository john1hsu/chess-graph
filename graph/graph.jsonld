    {
      "@id": "kt:semi-open-games",
      "@type": "kto:Concept",
      "skos:prefLabel": "Semi-open games",
      "skos:definition": "The family of openings in which Black answers 1.e4 with any move other than 1...e5, such as the Sicilian, French, Caro-Kann, Pirc, Scandinavian and Alekhine's Defence; the label is a historical classification rather than a description of how open the resulting positions are.",
      "kto:domain": "openings",
