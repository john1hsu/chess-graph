    {
      "@id": "kt:slav-defence",
      "@type": "kto:Opening",
      "skos:prefLabel": "Slav Defence",
      "skos:definition": "Black's reply 2...c6 to the Queen's Gambit (1.d4 d5 2.c4 c6), which supports the d5-pawn without shutting in the queen's bishop and prepares ...dxc4 followed by ...b5; it branches into the Slav Accepted (4...dxc4), the Semi-Slav (4...e6), the Chebanenko (4...a6) and the Exchange Slav (3.cxd5).",
      "kto:domain": "openings",
      "dcterms:created": "2026-11-11",
