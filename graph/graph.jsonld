      "@id": "kt:aspiration-window",
      "@type": "kto:Algorithm",
      "skos:prefLabel": "Aspiration window",
      "skos:definition": "An alpha-beta search technique that starts the root search with a narrow window of bounds centred on an expected score, usually the previous iteration's result, to gain extra cutoffs, and re-searches with a wider window only when the true score falls outside it.",
      "kto:domain": "computer-chess",
      "dcterms:created": "2026-11-17",
      "kto:verified": "2026-11-17",
      "kto:status": "current",
