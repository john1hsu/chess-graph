    {
      "@id": "kt:open-file",
      "@type": "kto:StrategicConcept",
      "skos:prefLabel": "Open file",
      "skos:definition": "A file with no pawns of either colour on it, which gives rooks and queens an unobstructed path into the enemy position; a half-open file has a pawn of only one side and is open for the other. Seizing and exploiting such files, usually to reach the seventh or eighth rank, is a basic positional theme.",
      "kto:domain": "middlegame-strategy",
