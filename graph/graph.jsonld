    {
      "@id": "kt:template-theory",
      "@type": "kto:CognitiveConcept",
      "skos:prefLabel": "Template theory",
      "skos:definition": "Fernand Gobet and Herbert Simon's 1996 revision of chunking theory, which holds that strong players store frequently met positions as long-term-memory templates: a fixed core of about a dozen pieces plus slots for variable details, plans and moves that can be filled within a fraction of a second.",
      "kto:domain": "training-and-improvement",
      "dcterms:created": "2026-11-11",
      "kto:verified": "2026-11-11",
      "kto:status": "current",
      "kto:volatile": false,
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Templates in chess memory: A mechanism for recalling several boards (Cognitive Psychology 31(1), 1-40)",
          "dcterms:publisher": "Fernand Gobet and Herbert A. Simon, Brunel University Research Archive",
          "schema:url": "https://bura.brunel.ac.uk/bitstream/2438/1339/1/Multiple_boards.pdf",
          "kto:sourceType": "peer-reviewed"
        },
        {
