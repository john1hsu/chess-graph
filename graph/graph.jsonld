    {
      "@id": "kt:monte-carlo-tree-search",
      "@type": "kto:Algorithm",
      "skos:prefLabel": "Monte Carlo tree search",
      "skos:definition": "A best-first game-tree search that grows an uneven tree by repeated simulations: each iteration selects a path from the root, expands a new node, estimates its value (by a random playout or a neural network) and backs the result up as an average, so effort concentrates on promising moves.",
      "kto:domain": "computer-chess",
      "dcterms:created": "2026-11-08",
      "kto:verified": "2026-11-08",
      "kto:status": "current",
      "kto:volatile": false,
