          "schema:url": "https://core.ac.uk/download/333524.pdf",
          "kto:sourceType": "peer-reviewed"
        },
        {
          "dcterms:title": "Expert memory: A comparison of four theories (Cognition 66, 115-152)",
          "dcterms:publisher": "Fernand Gobet, Brunel University Research Archive",
