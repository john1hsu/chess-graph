    {
      "@id": "kt:cognitive-psychology-of-chess",
      "@type": "kto:CognitiveConcept",
      "skos:prefLabel": "Cognitive psychology of chess",
      "skos:definition": "The scientific study of the mental processes behind chess play: perception, memory, imagery, search and decision making. Running from Alfred Binet's 1894 work on blindfold players to modern eye-tracking and brain imaging, it has used chess as a standard laboratory task for studying expertise.",
      "kto:domain": "training-and-improvement",
      "dcterms:created": "2026-11-10",
      "kto:verified": "2026-11-10",
      "kto:status": "current",
      "kto:volatile": false,
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Expertise in Chess (Cambridge Handbook of Expertise and Expert Performance, pp. 523-538)",
          "dcterms:publisher": "Fernand Gobet and Neil Charness, Cambridge University Press 2006, via CORE",
          "schema:url": "https://core.ac.uk/download/334186.pdf",
          "kto:sourceType": "academic"
        },
        {
          "dcterms:title": "The mind's eye in blindfold chess",
          "dcterms:publisher": "Guillermo Campitelli and Fernand Gobet, University of Nottingham, via CORE",
          "schema:url": "https://core.ac.uk/download/333506.pdf",
