      "@id": "kt:lucena-position",
      "@type": "kto:EndgameType",
      "skos:prefLabel": "Lucena position",
      "skos:definition": "The basic winning position in rook and pawn against rook: the stronger side's non-rook pawn stands on the seventh rank with its own king on the queening square and the defending king cut off, and the win is forced by \"building a bridge\" with the rook to shelter the king from checks.",
      "kto:domain": "endgames",
      "dcterms:created": "2026-11-07",
      "kto:verified": "2026-11-07",
      "kto:status": "current",
      "kto:volatile": false,
