    {
      "@id": "kt:berlin-defence",
      "@type": "kto:Variation",
      "skos:prefLabel": "Berlin Defence",
      "skos:definition": "The reply 3...Nf6 to the Ruy Lopez (1.e4 e5 2.Nf3 Nc6 3.Bb5), in which Black counterattacks e4 instead of first chasing the bishop; its main line leads to an early queen exchange, the \"Berlin Wall\" endgame, which Vladimir Kramnik used to beat Garry Kasparov in 2000.",
      "kto:domain": "openings",
      "dcterms:created": "2026-11-18",
