    {
      "@id": "kt:kings-gambit",
      "@type": "kto:Opening",
      "skos:prefLabel": "King's Gambit",
      "skos:definition": "An open game, 1.e4 e5 2.f4, in which White offers the f-pawn to deflect Black's e-pawn, build a full centre with d2-d4 and open the f-file against f7; the emblematic attacking opening of the Romantic era, rarely seen at the top today but never conclusively refuted.",
      "kto:domain": "openings",
      "dcterms:created": "2026-11-15",
