    {
      "@id": "kt:immortal-game",
      "@type": "kto:Game",
      "skos:prefLabel": "Immortal Game",
      "skos:definition": "The casual game won by Adolf Anderssen against Lionel Kieseritzky in London in 1851, in which Anderssen gave up a bishop, both rooks and finally his queen before mating with his minor pieces; it became the emblem of the Romantic era of chess.",
      "kto:domain": "history",
