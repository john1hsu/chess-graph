    {
      "@id": "kt:good-and-bad-bishops",
      "@type": "kto:StrategicConcept",
      "skos:prefLabel": "Good and bad bishops",
      "skos:definition": "The distinction between a bishop whose scope is free of its own pawns (a \"good\" bishop) and one hemmed in by its own pawns fixed on squares of its colour (a \"bad\" bishop); because pawn chains change slowly, the difference is semi-permanent and shapes plans, exchanges and endgames.",
      "kto:domain": "middlegame-strategy",
      "dcterms:created": "2026-11-11",
      "kto:verified": "2026-11-11",
      "kto:status": "current",
