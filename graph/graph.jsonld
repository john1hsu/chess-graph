    {
      "@id": "kt:move-ordering",
      "@type": "kto:Technique",
      "skos:prefLabel": "Move ordering",
      "skos:definition": "The set of heuristics a chess engine uses to decide in which order to search the moves at each node, trying the likely best move first so that alpha-beta pruning cuts off as many branches as possible and the search approaches the size of the minimal tree.",
      "kto:domain": "computer-chess",
      "dcterms:created": "2026-11-15",
      "kto:verified": "2026-11-15",
      "kto:status": "current",
      "kto:volatile": false,
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "The Anatomy of Chess Programs (8th World Computer Chess Championship brochure, 1995)",
          "dcterms:publisher": "T. Anthony Marsland, University of Alberta",
          "schema:url": "https://webdocs.cs.ualberta.ca/~tony/ICCA/anatomy.html",
          "kto:sourceType": "academic"
        },
        {
          "dcterms:title": "Heuristic Search in One and Two Player Games (revised for ACM Computing Surveys)",
