          "schema:url": "https://core.ac.uk/download/334663.pdf",
          "kto:sourceType": "academic"
        },
        {
          "dcterms:title": "What's in a name? The multiple meanings of 'chunk' and 'chunking' (Frontiers in Psychology 7:102)",
          "dcterms:publisher": "Fernand Gobet, Martyn Lloyd-Kelly and Peter C. R. Lane, Frontiers",
          "schema:url": "https://www.frontiersin.org/journals/psychology/articles/10.3389/fpsyg.2016.00102/pdf",
          "kto:sourceType": "peer-reviewed"
