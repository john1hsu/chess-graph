      "@id": "kt:touch-move",
      "@type": "kto:Rule",
      "skos:prefLabel": "Touch-move",
      "skos:definition": "The rule of over-the-board chess that a player on the move who deliberately touches one of their own pieces must move it, and who touches an opponent's piece must capture it, if that is legal; pieces may be adjusted without obligation only after announcing \"j'adoube\" or \"I adjust\".",
      "kto:domain": "rules-and-notation",
      "dcterms:created": "2026-11-08",
