    {
      "@id": "kt:cognitive-psychology-of-chess",
      "@type": "kto:CognitiveConcept",
      "skos:prefLabel": "Cognitive psychology of chess",
      "skos:definition": "The scientific study of the mental processes behind chess play: perception, memory, imagery, search and decision making. Running from Alfred Binet's 1894 work on blindfold players to modern eye-tracking and brain imaging, it has used chess as a standard laboratory task for studying expertise.",
      "kto:domain": "training-and-improvement",
      "dcterms:created": "2026-11-10",
      "kto:verified": "2026-11-10",
