    {
      "@id": "kt:progressive-deepening",
      "@type": "kto:CognitiveConcept",
      "skos:prefLabel": "Progressive deepening",
      "skos:definition": "Adriaan de Groot's name for the way chess players return again and again to the same candidate move or variation while thinking, each time looking a little further or with new information, instead of analysing every option once to a fixed depth.",
      "kto:domain": "training-and-improvement",
      "dcterms:created": "2026-11-13",
