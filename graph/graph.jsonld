      "@id": "kt:weak-squares",
      "@type": "kto:StrategicConcept",
      "skos:prefLabel": "Weak squares",
      "skos:definition": "Squares that one side can no longer contest, usually because the pawns that once guarded them have advanced or disappeared, so the opponent can control or occupy them without being dislodged; a single such square is a \"hole\", and a group of same-coloured ones is a weak colour complex.",
      "kto:domain": "middlegame-strategy",
      "dcterms:created": "2026-11-14",
