    {
      "@id": "kt:hypermodernism",
      "@type": "kto:School",
      "skos:prefLabel": "Hypermodernism",
      "skos:definition": "A school of chess thought that arose among central European masters after the First World War, led by Aron Nimzowitsch and Richard Réti, which challenged the classical doctrine of Steinitz and Tarrasch by arguing that the centre can be controlled from a distance by pieces rather than occupied early by pawns.",
      "kto:domain": "history",
      "dcterms:created": "2026-11-10",
