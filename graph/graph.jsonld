    {
      "@id": "kt:mikhail-botvinnik",
      "@type": "kto:Player",
      "skos:prefLabel": "Mikhail Botvinnik",
      "skos:definition": "Soviet grandmaster (1911–1995) and the sixth world chess champion, who won the vacant title in the 1948 match-tournament and held it three times between 1948 and 1963; regarded as the patriarch of the Soviet chess school for his scientific, methodical approach to preparation and play.",
