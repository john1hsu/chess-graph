    {
      "@id": "kt:einstellung-effect",
      "@type": "kto:CognitiveConcept",
      "skos:prefLabel": "Einstellung effect",
      "skos:definition": "The tendency for a familiar idea, triggered by features of a position, to stop a player from finding a better solution; in chess it was shown by Bilalić, McLeod and Gobet to work by steering experts' attention towards squares linked to the first idea.",
      "kto:domain": "training-and-improvement",
      "dcterms:created": "2026-11-09",
      "kto:verified": "2026-11-09",
      "kto:status": "current",
      "kto:volatile": false,
      "prov:wasDerivedFrom": [
