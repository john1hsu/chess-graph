      "@id": "kt:game-tree-search",
      "@type": "kto:Algorithm",
      "skos:prefLabel": "Game-tree search",
      "skos:definition": "The family of methods by which a program chooses a move by exploring the tree of positions reachable from the current one, where nodes are positions, edges are moves and each level is a ply; in chess the tree is far too large to explore fully, so searches are cut off and guided.",
      "kto:domain": "computer-chess",
      "dcterms:created": "2026-11-08",
