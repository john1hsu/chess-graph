      "@id": "kt:anatoly-karpov",
      "@type": "kto:Player",
      "skos:prefLabel": "Anatoly Karpov",
      "skos:definition": "Soviet-Russian grandmaster (born 1951) and the twelfth world chess champion, who received the title in 1975 when Bobby Fischer declined to defend it, held it until losing to Garry Kasparov in 1985, and was later FIDE world champion from 1993 to 1999; famous for prophylactic, positional play.",
      "kto:domain": "players",
      "dcterms:created": "2026-11-10",
