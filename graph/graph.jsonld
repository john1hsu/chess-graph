    {
      "@id": "kt:minority-attack",
      "@type": "kto:StrategicConcept",
      "skos:prefLabel": "Minority attack",
      "skos:definition": "A middlegame plan in which one side advances fewer pawns against the opponent's larger pawn group on the same wing, typically White's b2–b4–b5 against Black's a-, b- and c-pawns in the Carlsbad structure, in order to open a half-open file and leave the defender with a weak backward or isolated pawn.",
      "kto:domain": "middlegame-strategy",
      "dcterms:created": "2026-11-13",
      "kto:verified": "2026-11-13",
      "kto:status": "current",
