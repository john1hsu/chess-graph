    {
      "@id": "kt:queens-gambit-accepted",
      "@type": "kto:Opening",
      "skos:prefLabel": "Queen's Gambit Accepted",
      "skos:definition": "Black's reply 2...dxc4 to the Queen's Gambit (1.d4 d5 2.c4 dxc4), giving up the centre pawn on d5 to free the pieces and counter-attack White's centre, usually returning the c4-pawn rather than holding it; White chooses mainly between the classical 3.Nf3 with e3 and Bxc4, and the space-gaining 3.e4.",
      "kto:domain": "openings",
      "dcterms:created": "2026-11-12",
