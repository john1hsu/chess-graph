      "@id": "kt:minimax",
      "@type": "kto:Algorithm",
      "skos:prefLabel": "Minimax",
      "skos:definition": "The basic decision rule of game-tree search: each side is assumed to choose the move best for itself, so values are backed up from the leaves by taking the maximum at the searching side's turns and the minimum at the opponent's, and the move leading to the best backed-up value is played.",
      "kto:domain": "computer-chess",
      "dcterms:created": "2026-11-07",
