    {
      "@id": "kt:hanging-pawns",
      "@type": "kto:PawnStructure",
      "skos:prefLabel": "Hanging pawns",
      "skos:definition": "A pawn structure in which one side has two pawns side by side on adjacent half-open files, typically c5 and d5 (or c4 and d4), with no friendly pawns on the neighbouring files; they give space and dynamic potential but can only be defended by pieces.",
      "kto:domain": "middlegame-strategy",
      "dcterms:created": "2026-11-12",
      "kto:verified": "2026-11-12",
      "kto:status": "current",
      "kto:volatile": false,
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Hanging Pawns in Chess",
          "dcterms:publisher": "Edward Winter, Chess Notes (chesshistory.com)",
          "schema:url": "https://chesshistory.com/winter/extra/hangingpawns.html",
          "kto:sourceType": "reference"
        },
        {
          "dcterms:title": "How to Play the Queen's Gambit (Games 10-12)",
          "dcterms:publisher": "Garry Kasparov, ChessBase Books",
          "schema:url": "https://books.chessbase.com/perma/c/68945b8ee30c7d2f77098b5a",
          "kto:sourceType": "book"
