      "@id": "kt:windmill",
      "@type": "kto:TacticalMotif",
      "skos:prefLabel": "Windmill",
      "skos:definition": "A repeating combination in which a rook (or other piece) shuttles between two squares next to the enemy king, alternately giving check and uncovering a discovered check from a supporting piece, so that it can capture material on every cycle while the king is unable to escape.",
      "kto:domain": "tactics",
      "dcterms:created": "2026-11-17",
      "kto:verified": "2026-11-17",
