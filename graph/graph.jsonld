      "@id": "kt:back-rank-mate",
      "@type": "kto:MatingPattern",
      "skos:prefLabel": "Back-rank mate",
      "skos:definition": "A checkmate delivered by a rook or queen along the opponent's first rank, where the king cannot escape because the squares in front of it are blocked by its own pawns or covered by enemy pieces.",
      "kto:domain": "tactics",
      "dcterms:created": "2026-11-12",
      "kto:verified": "2026-11-12",
