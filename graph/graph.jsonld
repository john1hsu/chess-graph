    {
      "@id": "kt:chess-expertise",
      "@type": "kto:CognitiveConcept",
      "skos:prefLabel": "Chess expertise",
      "skos:definition": "The study of what makes strong chess players strong: how chess skill is measured, how it develops over a lifetime, and how much of it is explained by practice, starting age and general cognitive ability. Chess has long served psychology as a model domain for expertise research.",
      "kto:domain": "training-and-improvement",
      "dcterms:created": "2026-11-10",
      "kto:verified": "2026-11-10",
      "kto:status": "current",
      "kto:volatile": false,
      "prov:wasDerivedFrom": [
        {
