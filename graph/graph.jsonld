    {
      "@id": "kt:horizon-effect",
      "@type": "kto:Concept",
      "skos:prefLabel": "Horizon effect",
      "skos:definition": "The class of misjudgements a depth-limited game-tree search makes because it cannot see past its maximum search depth: it may push an unavoidable loss just beyond that horizon and believe it avoided, or grab a gain too early because its consequences lie out of sight.",
      "kto:domain": "computer-chess",
      "dcterms:created": "2026-11-08",
      "kto:verified": "2026-11-08",
      "kto:status": "current",
      "kto:volatile": false,
      "prov:wasDerivedFrom": [
        {
