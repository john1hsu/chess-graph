          "dcterms:publisher": "Ward Farnsworth, chesstactics.org",
          "schema:url": "https://www.chesstactics.org/the-double-attack/the-knight-fork/strategic-implications/2_1_12_1.html",
          "kto:sourceType": "publication"
        },
        {
          "dcterms:title": "Chess Pattern Recognition for Beginners (sample pages)",
          "dcterms:publisher": "Arthur van de Oudeweetering, New In Chess (2018)",
          "schema:url": "https://www.newinchess.com/media/wysiwyg/product_pdf/9069.pdf",
          "kto:sourceType": "book"
