    {
      "@id": "kt:talent",
      "@type": "kto:CognitiveConcept",
      "skos:prefLabel": "Talent",
      "skos:definition": "The idea that players differ in inborn or early-appearing capacities that let some of them learn chess faster and reach higher levels than others with the same amount of practice; in expertise research it is the main rival, or complement, to practice-only explanations of chess skill.",
      "kto:domain": "training-and-improvement",
      "dcterms:created": "2026-11-14",
      "kto:verified": "2026-11-14",
      "kto:status": "contested",
