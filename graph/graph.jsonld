    {
      "@id": "kt:london-1851",
      "@type": "kto:Event",
      "skos:prefLabel": "London 1851",
      "skos:definition": "The sixteen-player knockout tournament organised by Howard Staunton in London during the Great Exhibition of 1851, generally regarded as the first international chess tournament; it was won by Adolf Anderssen, who beat Marmaduke Wyvill in the final.",
